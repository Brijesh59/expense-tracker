{
  "expo": {
    "name": "Luma",
    "slug": "luma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luma",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3F1DBA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brijesh.luma",
      "appleTeamId": "VSYD28RGYB",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Luma sends reminders to help you log expenses and stay on budget.",
        "NSSpeechRecognitionUsageDescription": "Luma uses speech recognition so you can log expenses by voice.",
        "NSMicrophoneUsageDescription": "Luma uses the microphone to listen for your expense descriptions.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0F14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.brijesh.luma"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#7C6AF7",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Luma to use the microphone to log expenses by voice.",
          "speechRecognitionPermission": "Allow Luma to use speech recognition to log expenses by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "45af8bc2-f2ec-455d-8cd6-7bf823c4bd3c"
      }
    }
  }
}
